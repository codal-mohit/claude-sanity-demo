{
  "name": "claude-code-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "typegen": "sanity schema extract --path src/sanity/extract.json && sanity typegen generate",
    "seed": "node --env-file=.env.local tools/seed.mjs",
    "migrate:dry": "sanity migration run",
    "dataset:backup": "sanity dataset export production backups/production.tar.gz --overwrite",
    "dataset:staging": "sanity dataset copy production staging --skip-history"
  },
  "dependencies": {
    "@sanity/document-internationalization": "^4.1.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^4.22.1",
    "class-variance-authority": "^0.7.1",
    "next": "15.5.4",
    "next-sanity": "^11.6.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^4.22.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
